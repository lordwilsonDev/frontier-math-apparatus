{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transfer",
  "type": "object",
  "required": [
    "tested",
    "result",
    "run_id",
    "control_run_id"
  ],
  "properties": {
    "tested": {
      "type": "boolean"
    },
    "problem_id": {
      "type": "string"
    },
    "result": {
      "enum": [
        "TRANSFERRED",
        "DID_NOT_TRANSFER",
        "INCONCLUSIVE"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "control_run_id": {
      "type": "string"
    }
  }
}
