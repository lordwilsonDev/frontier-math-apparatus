{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attempt",
  "type": "object",
  "required": [
    "attempt_id",
    "reference_blind",
    "candidate_result"
  ],
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "reference_blind": {
      "type": "boolean"
    },
    "strategy": {
      "type": "string"
    },
    "derivation": {
      "type": "string"
    },
    "intermediate_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_result": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "required": [
        "model",
        "knowledge_cutoff",
        "web_access",
        "code_execution"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_cutoff": {
          "type": "string",
          "minLength": 4
        },
        "web_access": {
          "type": "boolean"
        },
        "code_execution": {
          "type": "boolean"
        }
      }
    },
    "actor": {
      "type": "string"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "contamination_risk": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lesson_applied": {
      "type": "boolean"
    }
  }
}
